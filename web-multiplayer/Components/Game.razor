@using System.Linq
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.Extensions.Hosting
@implements IAsyncDisposable
@inject LocalGameSession Local
@inject NavigationManager Nav
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment

<div class="app-shell">
    <main class="app-main">
        @switch (_phase)
        {
            case AppPhase.MainMenu:
                <MainMenu OnHotSeat="StartHotSeat"
                          OnVsComputer="GoToModeSetup"
                          OnNetwork="GoToNetwork" />
                break;

            case AppPhase.LocalModeSetup:
                <ModeSetup OnBack="GoToMainMenu" OnStart="StartVersusComputer" />
                break;

            case AppPhase.LocalInMatch:
            case AppPhase.LocalMatchOver:
                <div class="match-panel">
                    <div class="status-banner" role="status" aria-live="polite" aria-atomic="true">
                        @if (_phase == AppPhase.LocalMatchOver)
                        {
                            @if (Local.Winner is { } w)
                            {
                                <span class="status-text status-@FactionClass(w)">@ThemeText.WinMessage(w)</span>
                            }
                            else if (Local.IsDraw)
                            {
                                <span class="status-text">@ThemeText.DrawMessage()</span>
                            }
                        }
                        else if (Local.AiThinking)
                        {
                            <span class="status-text status-@FactionClass(Local.Active) status-thinking">
                                @ThemeText.NameOf(Local.Active) considers the grid…
                            </span>
                        }
                        else
                        {
                            <span class="status-text status-@FactionClass(Local.Active)">
                                @ThemeText.NameOf(Local.Active) — claim a sector
                            </span>
                        }
                    </div>

                    <BoardView Board="Local.Board"
                               HoverPlayer="@(Local.VersusComputer ? Local.HumanSide : Local.Active)"
                               AcceptingClicks="@(_phase == AppPhase.LocalInMatch && !Local.AiThinking && (!Local.VersusComputer || Local.Active == Local.HumanSide))"
                               WinningCells="Local.WinningCells"
                               OnCellClick="OnLocalCellClick" />

                    <ScoreBoard AscendantWins="Local.AscendantWins"
                                VanguardWins="Local.VanguardWins"
                                Draws="Local.Draws"
                                ShowReset="true"
                                OnReset="ResetLocalScore" />

                    <div class="menu-buttons">
                        @if (_phase == AppPhase.LocalMatchOver)
                        {
                            <button class="btn btn-primary" @onclick="PlayAgainLocal">Play again</button>
                        }
                        <button class="btn btn-secondary" @onclick="GoToMainMenu">Main menu</button>
                    </div>
                </div>
                break;

            case AppPhase.NetworkConnecting:
                <div class="menu-panel">
                    <h2 class="subtitle">Connecting…</h2>
                    <div class="menu-buttons">
                        <button class="btn btn-secondary" @onclick="GoToMainMenu">Cancel</button>
                    </div>
                </div>
                break;

            case AppPhase.NetworkLobby:
                @if (_networkNotice is not null)
                {
                    <p class="status-text" role="status">@_networkNotice</p>
                }
                <Lobby YourName="@_yourName"
                       Players="@_lobbyPlayers"
                       PendingChallengeFor="@_pendingTargetName"
                       CancelPendingDisabled="@(_pendingChallengeId is null)"
                       OnChallenge="ChallengePlayerByConnId"
                       OnCancelPending="CancelPendingChallenge"
                       OnLeave="LeaveNetwork" />
                break;

            case AppPhase.NetworkInMatch:
            case AppPhase.NetworkMatchOver:
                <div class="match-panel">
                    <div class="status-banner" role="status" aria-live="polite" aria-atomic="true">
                        @if (_phase == AppPhase.NetworkMatchOver)
                        {
                            <span class="status-text status-@(_netResultClass)">@_netEndMessage</span>
                        }
                        else if (_recoveringConnection)
                        {
                            <span class="status-text" role="status">Reconnecting…</span>
                        }
                        else
                        {
                            <span class="status-text status-@FactionClass(_netActiveFaction)">
                                @(_netActiveFaction == _yourFaction
                                    ? "Your move"
                                    : $"{_opponentName}'s move…")
                            </span>
                        }
                    </div>

                    @if (_opponentDisconnected)
                    {
                        <DisconnectBanner OpponentName="@_opponentName" InitialSeconds="30" />
                    }

                    <BoardView Board="@_netBoard"
                               HoverPlayer="@_yourFaction"
                               AcceptingClicks="@(_phase == AppPhase.NetworkInMatch && _netActiveFaction == _yourFaction && !_opponentDisconnected && !_recoveringConnection && !_forfeitPending)"
                               WinningCells="@_netWinningCells"
                               OnCellClick="OnNetCellClick" />

                    @if (HostEnvironment.IsDevelopment() && _phase == AppPhase.NetworkInMatch)
                    {
                        <details class="connection-test-panel">
                            <summary>Local test controls</summary>
                            <div class="connection-test-buttons">
                                <button class="btn btn-secondary" disabled="@(_recoveringConnection || _forfeitPending || _connectionTestCancellation is not null)"
                                        @onclick="@(() => TestConnectionAsync(TimeSpan.FromSeconds(3)))">Test reconnect</button>
                                <button class="btn btn-secondary" disabled="@(_recoveringConnection || _forfeitPending || _connectionTestCancellation is not null)"
                                        @onclick="@(() => TestConnectionAsync(TimeSpan.FromSeconds(35)))">Test timeout</button>
                            </div>
                            <p class="connection-test-help">Reconnect pauses for 3 seconds. Timeout pauses for 35 seconds; your opponent wins after 30 seconds.</p>
                            @if (_connectionTestStatus is not null)
                            {
                                <p role="status">@_connectionTestStatus</p>
                            }
                            @if (_connectionTestCancellation is not null || _hub?.State != HubConnectionState.Connected)
                            {
                                <button class="btn btn-link" @onclick="GoToMainMenu">Cancel test and return to menu</button>
                            }
                        </details>
                    }

                    @if (_phase == AppPhase.NetworkMatchOver)
                    {
                        <div class="menu-buttons">
                            <button class="btn btn-primary" @onclick="ReturnToLobby">Back to lobby</button>
                            <button class="btn btn-secondary" @onclick="GoToMainMenu">Main menu</button>
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-secondary" @onclick="ForfeitNetworkMatch"
                                disabled="@(_recoveringConnection || _forfeitPending || _connectionTestCancellation is not null || _hub?.State != HubConnectionState.Connected)">Forfeit</button>
                        @if (_networkNotice is not null)
                        {
                            <p role="status">@_networkNotice</p>
                        }
                    }
                </div>
                break;
        }

        @if (_incomingChallengeId is not null)
        {
            <ChallengePrompt FromName="@(_incomingChallengeFromName!)"
                             TotalSeconds="30"
                             OnAccept="AcceptChallenge"
                             OnDecline="DeclineChallenge" />
        }
    </main>
</div>

@code {
    private enum AppPhase
    {
        MainMenu, LocalModeSetup, LocalInMatch, LocalMatchOver,
        NetworkConnecting, NetworkLobby, NetworkInMatch, NetworkMatchOver
    }

    private AppPhase _phase = AppPhase.MainMenu;

    // Network state
    private Microsoft.AspNetCore.SignalR.Client.HubConnection? _hub;
    private string _yourConnId = "";
    private string _yourName = "";
    private List<Lobby.LobbyEntry> _lobbyPlayers = new();
    private string? _pendingChallengeId;
    private string? _pendingTargetConnId;
    private string? _pendingTargetName;
    private string? _incomingChallengeId;
    private string? _incomingChallengeFromConnId;
    private string? _incomingChallengeFromName;
    private string? _matchId;
    // Kept only in this component's memory for the current match. It never belongs
    // in lobby state, URLs, or a shared match-state payload.
    private string? _reconnectToken;
    private CancellationTokenSource? _rejoinCancellation;
    private CancellationTokenSource? _connectionTestCancellation;
    private string? _connectionTestStatus;
    private bool _recoveringConnection;
    private string? _networkNotice;
    private string _opponentName = "";
    private Player _yourFaction = Player.None;
    private Board _netBoard = new();
    private Player _netActiveFaction = Player.Ascendant;
    private (int row, int col)[]? _netWinningCells;
    private string? _netEndMessage;
    private string _netResultClass = "ascendant";
    private bool _opponentDisconnected;
    private bool _forfeitPending;

    // Lifecycle
    protected override void OnInitialized()
    {
        Local.OnChange += HandleLocalChange;
    }

    public async ValueTask DisposeAsync()
    {
        Local.OnChange -= HandleLocalChange;
        await TeardownHubAsync();
    }

    private void HandleLocalChange()
    {
        // Only update _phase from Local.Phase if we're currently in a local-mode phase
        // (don't accidentally jump to Local* from Network*).
        if (_phase != AppPhase.MainMenu &&
            _phase != AppPhase.LocalModeSetup &&
            _phase != AppPhase.LocalInMatch &&
            _phase != AppPhase.LocalMatchOver)
            return;

        _phase = Local.Phase switch
        {
            LocalPhase.MainMenu  => AppPhase.MainMenu,
            LocalPhase.ModeSetup => AppPhase.LocalModeSetup,
            LocalPhase.InMatch   => AppPhase.LocalInMatch,
            LocalPhase.MatchOver => AppPhase.LocalMatchOver,
            _ => _phase
        };
        InvokeAsync(StateHasChanged);
    }

    // Local mode handlers
    private void StartHotSeat() => Local.StartHotSeat();
    private void GoToModeSetup() => Local.GoToModeSetup();
    private async Task StartVersusComputer((Player faction, Difficulty difficulty) args)
        => await Local.StartVersusComputerAsync(args.faction, args.difficulty);

    private async Task GoToMainMenu()
    {
        _phase = AppPhase.MainMenu;
        Local.GoToMainMenu();
        await TeardownHubAsync();
    }

    private async Task OnLocalCellClick((int row, int col) move)
        => await Local.TryHumanMoveAsync(move.row, move.col);

    private async Task PlayAgainLocal() => await Local.PlayAgainAsync();
    private void ResetLocalScore() => Local.ResetScores();

    // Network mode handlers
    private async Task GoToNetwork()
    {
        _networkNotice = null;
        _phase = AppPhase.NetworkConnecting;
        StateHasChanged();
        await EnsureHubAsync();
        if (_phase == AppPhase.NetworkConnecting && _hub is not null)
            await _hub.SendAsync("EnterLobby");
    }

    private async Task LeaveNetwork()
    {
        if (_hub is not null) await _hub.SendAsync("LeaveLobby");
        await TeardownHubAsync();
        _phase = AppPhase.MainMenu;
        StateHasChanged();
    }

    private async Task EnsureHubAsync()
    {
        if (_hub is not null) return;
        var hubUrl = Nav.ToAbsoluteUri("/gamehub");
        _hub = new Microsoft.AspNetCore.SignalR.Client.HubConnectionBuilder()
            .WithUrl(hubUrl)
            .WithAutomaticReconnect()
            .Build();

        var hub = _hub;
        // Serialize hub callbacks with UI events and reconnect cleanup on the
        // component dispatcher, including while an invocation is awaiting a reply.
        Task Receive(Action callback) => InvokeAsync(() =>
        {
            if (_hub == hub) callback();
        });
        hub.On<LobbyState>("OnLobbyState", s => Receive(() => OnLobbyState(s)));
        hub.On<LobbyPlayer>("OnPlayerJoined", p => Receive(() => OnPlayerJoined(p)));
        hub.On<PlayerLeft>("OnPlayerLeft", p => Receive(() => OnPlayerLeft(p)));
        hub.On<IncomingChallenge>("OnIncomingChallenge", c => Receive(() => OnIncomingChallenge(c)));
        hub.On<ChallengeSentMsg>("OnChallengeSent", c => Receive(() => OnChallengeSent(c)));
        hub.On<ChallengeResolution>("OnChallengeAccepted", r => Receive(() => OnChallengeAccepted(r)));
        hub.On<DeclineMessage>("OnChallengeDeclined", m => Receive(() => OnChallengeDeclined(m)));
        hub.On<ChallengeExpiredMsg>("OnChallengeExpired", e => Receive(() => OnChallengeExpired(e)));
        hub.On<ChallengeCancelledMsg>("OnChallengeCancelled", e => Receive(() => OnChallengeCancelled(e)));
        hub.On<MatchStateMsg>("OnMatchState", m => Receive(() => OnMatchState(m)));
        hub.On<DisconnectInfo>("OnOpponentDisconnected", d => Receive(() => OnOpponentDisconnected(d)));
        hub.On("OnOpponentReconnected", () => Receive(OnOpponentReconnected));
        hub.On<MatchEnded>("OnMatchEnded", e => Receive(() => OnMatchEnded(e)));

        hub.Reconnecting += _ => InvokeAsync(() =>
        {
            if (_hub != hub) return;
            _recoveringConnection = true;
            _pendingChallengeId = null;
            _pendingTargetName = null;
            _pendingTargetConnId = null;
            _incomingChallengeId = null;
            CancelRejoinAttempt();
            StateHasChanged();
        });
        hub.Reconnected += _ => InvokeAsync(() => RestoreNetworkSessionAsync(hub));

        await hub.StartAsync();
    }

    private async Task TeardownHubAsync()
    {
        ClearReconnectCredentials();
        var hub = _hub;
        _hub = null;
        _yourConnId = "";
        _yourName = "";
        _lobbyPlayers.Clear();
        _pendingChallengeId = null;
        _pendingTargetConnId = null;
        _pendingTargetName = null;
        _incomingChallengeId = null;
        _matchId = null;
        if (hub is not null) await hub.DisposeAsync();
    }

    private async Task RestoreNetworkSessionAsync(HubConnection hub)
    {
        if (_hub != hub) return;

        _yourConnId = hub.ConnectionId ?? "";
        CancelRejoinAttempt();
        using var cancellation = new CancellationTokenSource();
        _rejoinCancellation = cancellation;
        _recoveringConnection = true;

        try
        {
            if (_phase != AppPhase.NetworkInMatch || _matchId is null)
            {
                if (_phase == AppPhase.NetworkLobby)
                    await hub.InvokeAsync("EnterLobby", cancellation.Token);
                return;
            }

            var matchId = _matchId;
            var reconnectToken = _reconnectToken;
            // SignalR may reconnect before the old connection's disconnect handler
            // runs. Retry briefly without letting a live slot be claimed early.
            for (var attempt = 0; !string.IsNullOrEmpty(reconnectToken) && attempt < 40; attempt++)
            {
                if (_hub != hub || _matchId != matchId || _reconnectToken != reconnectToken ||
                    _phase != AppPhase.NetworkInMatch || hub.State != HubConnectionState.Connected)
                    return;

                if (await hub.InvokeAsync<bool>("RejoinMatch", matchId, reconnectToken, cancellation.Token))
                    return;

                await Task.Delay(TimeSpan.FromMilliseconds(250), cancellation.Token);
            }

            if (_hub != hub || _matchId != matchId || _reconnectToken != reconnectToken ||
                _phase != AppPhase.NetworkInMatch)
                return;

            // Rejected or expired credentials do not become a win or a new identity
            // in the old match. The player can start a new match from the lobby.
            _reconnectToken = null;
            _networkNotice = "The match could not be rejoined. You can start a new match.";
            await ReturnToLobby();
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        catch (Exception) when (hub.State != HubConnectionState.Connected)
        {
            // A further connection loss is handled by automatic reconnect again.
        }
        finally
        {
            if (ReferenceEquals(_rejoinCancellation, cancellation))
            {
                _rejoinCancellation = null;
                _recoveringConnection = hub.State != HubConnectionState.Connected;
                StateHasChanged();
            }
        }
    }

    private void CancelRejoinAttempt()
    {
        _rejoinCancellation?.Cancel();
        _rejoinCancellation = null;
    }

    private void ClearReconnectCredentials()
    {
        _forfeitPending = false;
        _reconnectToken = null;
        CancelRejoinAttempt();
        _connectionTestCancellation?.Cancel();
        _connectionTestCancellation = null;
        _connectionTestStatus = null;
        _recoveringConnection = false;
    }

    private async Task TestConnectionAsync(TimeSpan pause)
    {
        // This is a local Development aid, never an externally callable hub action.
        if (!HostEnvironment.IsDevelopment() || _phase != AppPhase.NetworkInMatch ||
            _hub is not { State: HubConnectionState.Connected } hub ||
            _matchId is null || _reconnectToken is null || _recoveringConnection ||
            _connectionTestCancellation is not null)
            return;

        using var cancellation = new CancellationTokenSource();
        _connectionTestCancellation = cancellation;
        var matchId = _matchId;
        _recoveringConnection = true;
        _connectionTestStatus = $"Connection paused for {pause.TotalSeconds:0} seconds. Watch the other player's window.";
        StateHasChanged();

        try
        {
            // Keep the Blazor circuit alive while restarting only this player's
            // separate game connection. Stop/Start does not raise Reconnected.
            await hub.StopAsync(cancellation.Token);
            await Task.Delay(pause, cancellation.Token);
            if (_hub != hub || _matchId != matchId || _phase != AppPhase.NetworkInMatch)
                return;

            _connectionTestStatus = "Restoring the saved match…";
            StateHasChanged();
            await hub.StartAsync(cancellation.Token);
            await RestoreNetworkSessionAsync(hub);
            if (_hub == hub && _matchId == matchId && _phase == AppPhase.NetworkInMatch)
                _connectionTestStatus = "Reconnected. The same match is ready to continue.";
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            if (_hub == hub)
                _connectionTestStatus = "The connection test could not finish. Return to the menu and reconnect.";
        }
        finally
        {
            if (ReferenceEquals(_connectionTestCancellation, cancellation))
            {
                _connectionTestCancellation = null;
                _recoveringConnection = hub.State != HubConnectionState.Connected;
                StateHasChanged();
            }
        }
    }

    private async Task ChallengePlayerByConnId(string targetConnId)
    {
        if (_hub is not { State: HubConnectionState.Connected } hub ||
            _phase != AppPhase.NetworkLobby || _pendingTargetName is not null) return;
        var target = _lobbyPlayers.FirstOrDefault(p => p.ConnId == targetConnId);
        if (target is null) return;
        _pendingTargetName = target.Name;
        _pendingTargetConnId = targetConnId;
        _networkNotice = null;
        try
        {
            var challengeId = await hub.InvokeAsync<string?>("ChallengePlayer", targetConnId);
            // The recipient may accept or we may leave while this acknowledgement
            // is in flight. Never revive pending UI for an obsolete request.
            if (_hub != hub || _phase != AppPhase.NetworkLobby || _pendingTargetName != target.Name)
            {
                if (challengeId is not null && hub.State == HubConnectionState.Connected)
                    await hub.SendAsync("CancelChallenge", challengeId);
                return;
            }
            _pendingChallengeId = challengeId;
            if (challengeId is null)
            {
                _pendingTargetName = null;
                _networkNotice = "That player is unavailable. Choose another player.";
            }
        }
        catch (Exception)
        {
            if (_hub == hub && _phase == AppPhase.NetworkLobby)
            {
                _pendingChallengeId = null;
                _pendingTargetName = null;
                _networkNotice = "Could not send the challenge. Try again.";
            }
        }
    }

    private async Task CancelPendingChallenge()
    {
        if (_hub is not { State: HubConnectionState.Connected } hub ||
            _pendingChallengeId is not { } challengeId || _recoveringConnection) return;
        try
        {
            await hub.InvokeAsync("CancelChallenge", challengeId);
        }
        catch (Exception)
        {
            if (_hub == hub && _pendingChallengeId == challengeId)
                _networkNotice = "Could not cancel the challenge. Try again.";
        }
        StateHasChanged();
    }

    private async Task AcceptChallenge()
    {
        if (_hub is null || _incomingChallengeId is null) return;
        var id = _incomingChallengeId;
        _incomingChallengeId = null;
        await _hub.SendAsync("RespondToChallenge", id, true);
    }

    private async Task DeclineChallenge()
    {
        if (_hub is null || _incomingChallengeId is null) return;
        var id = _incomingChallengeId;
        _incomingChallengeId = null;
        await _hub.SendAsync("RespondToChallenge", id, false);
        StateHasChanged();
    }

    private async Task OnNetCellClick((int row, int col) move)
    {
        if (_hub is null || _matchId is null || _recoveringConnection || _forfeitPending) return;
        await _hub.SendAsync("PlaceMove", _matchId, move.row, move.col);
    }

    private async Task ForfeitNetworkMatch()
    {
        if (_phase != AppPhase.NetworkInMatch || _matchId is not { } matchId ||
            _hub is not { State: HubConnectionState.Connected } hub ||
            _recoveringConnection || _forfeitPending || _connectionTestCancellation is not null)
            return;

        _forfeitPending = true;
        _networkNotice = null;
        try
        {
            // Wait for the existing server-authorized result; do not invent a
            // local win/loss or leave the opponent in an abandoned match.
            await hub.InvokeAsync("ForfeitMatch", matchId);
        }
        catch (Exception)
        {
            if (_hub == hub && _matchId == matchId && _phase == AppPhase.NetworkInMatch)
                _networkNotice = "Could not forfeit. Reconnect and try again.";
        }
        finally
        {
            if (_hub == hub && _matchId == matchId) _forfeitPending = false;
        }
    }

    private async Task ReturnToLobby()
    {
        ClearReconnectCredentials();
        _phase = AppPhase.NetworkLobby;
        _matchId = null;
        _netBoard = new Board();
        _netWinningCells = null;
        _netEndMessage = null;
        _opponentDisconnected = false;
        if (_hub is not null) await _hub.SendAsync("EnterLobby");
        StateHasChanged();
    }

    // Hub message records
    private record LobbyState(string yourConnId, string yourName, List<LobbyPlayer> players);
    private record PlayerLeft(string connId);
    private record IncomingChallenge(string challengeId, string fromConnId, string fromName);
    private record ChallengeSentMsg(string challengeId, string targetConnId);
    private record ChallengeResolution(string matchId, string opponentName, string yourFaction, string reconnectToken);
    private record DeclineMessage(string challengeId, string fromName);
    private record ChallengeExpiredMsg(string challengeId, string role);
    private record ChallengeCancelledMsg(string challengeId);
    private record MatchStateMsg(string matchId, int[][] board, string activeFaction, string? winner, bool isDraw, CellRef[]? winningCells);
    private record CellRef(int row, int col);
    private record DisconnectInfo(int secondsLeft);
    private record MatchEnded(string matchId, string result, string reason, CellRef[]? winningCells);

    // Hub callbacks
    private void OnChallengeSent(ChallengeSentMsg sent)
    {
        if (_phase == AppPhase.NetworkLobby && _pendingTargetName is not null &&
            sent.targetConnId == _pendingTargetConnId)
            _pendingChallengeId = sent.challengeId;
    }

    private void OnLobbyState(LobbyState s)
    {
        _yourConnId = s.yourConnId;
        _yourName = s.yourName;
        _lobbyPlayers = s.players
            .Where(p => p.ConnectionId != s.yourConnId)
            .Select(p => new Lobby.LobbyEntry(p.ConnectionId, p.Name))
            .ToList();
        _phase = AppPhase.NetworkLobby;
        InvokeAsync(StateHasChanged);
    }

    private void OnPlayerJoined(LobbyPlayer p)
    {
        if (p.ConnectionId == _yourConnId) return;
        if (_lobbyPlayers.Any(x => x.ConnId == p.ConnectionId)) return;
        _lobbyPlayers.Add(new Lobby.LobbyEntry(p.ConnectionId, p.Name));
        InvokeAsync(StateHasChanged);
    }

    private void OnPlayerLeft(PlayerLeft p)
    {
        _lobbyPlayers.RemoveAll(x => x.ConnId == p.connId);
        InvokeAsync(StateHasChanged);
    }

    private void OnIncomingChallenge(IncomingChallenge c)
    {
        _incomingChallengeId = c.challengeId;
        _incomingChallengeFromConnId = c.fromConnId;
        _incomingChallengeFromName = c.fromName;
        InvokeAsync(StateHasChanged);
    }

    private void OnChallengeAccepted(ChallengeResolution r)
    {
        ClearReconnectCredentials();
        _matchId = r.matchId;
        _reconnectToken = r.reconnectToken;
        _networkNotice = null;
        _opponentName = r.opponentName;
        _yourFaction = r.yourFaction == "Ascendant" ? Player.Ascendant : Player.Vanguard;
        _netBoard = new Board();
        _netActiveFaction = Player.Ascendant;
        _netWinningCells = null;
        _netEndMessage = null;
        _opponentDisconnected = false;
        _phase = AppPhase.NetworkInMatch;
        _pendingChallengeId = null;
        _pendingTargetName = null;
        _incomingChallengeId = null;
        InvokeAsync(StateHasChanged);
    }

    private void OnChallengeDeclined(DeclineMessage m)
    {
        if (m.challengeId != _pendingChallengeId) return;
        _pendingChallengeId = null;
        _pendingTargetName = null;
        InvokeAsync(StateHasChanged);
    }

    private void OnChallengeExpired(ChallengeExpiredMsg e)
    {
        if (e.role == "from" && e.challengeId == _pendingChallengeId) { _pendingChallengeId = null; _pendingTargetName = null; }
        else if (e.role == "to" && e.challengeId == _incomingChallengeId) { _incomingChallengeId = null; }
        InvokeAsync(StateHasChanged);
    }

    private void OnChallengeCancelled(ChallengeCancelledMsg e)
    {
        if (e.challengeId == _pendingChallengeId) { _pendingChallengeId = null; _pendingTargetName = null; }
        if (e.challengeId == _incomingChallengeId) _incomingChallengeId = null;
        InvokeAsync(StateHasChanged);
    }

    private void OnMatchState(MatchStateMsg m)
    {
        if (m.matchId != _matchId) return;
        // An in-flight snapshot can arrive after the match-ended event.
        if (_phase == AppPhase.NetworkMatchOver && m.winner is null && !m.isDraw) return;
        _netBoard = DeserializeBoard(m.board);
        _netActiveFaction = ParsePlayer(m.activeFaction);
        _netWinningCells = m.winningCells?.Select(c => (c.row, c.col)).ToArray();
        if (m.winner is not null || m.isDraw)
        {
            ClearReconnectCredentials();
            _opponentDisconnected = false;
            _phase = AppPhase.NetworkMatchOver;
        }
        else
        {
            _phase = AppPhase.NetworkInMatch;
        }
        InvokeAsync(StateHasChanged);
    }

    private void OnOpponentDisconnected(DisconnectInfo d)
    {
        _opponentDisconnected = true;
        InvokeAsync(StateHasChanged);
    }

    private void OnOpponentReconnected()
    {
        _opponentDisconnected = false;
        InvokeAsync(StateHasChanged);
    }

    private void OnMatchEnded(MatchEnded e)
    {
        if (e.matchId != _matchId) return;
        ClearReconnectCredentials();
        _opponentDisconnected = false;
        _phase = AppPhase.NetworkMatchOver;
        _netEndMessage = (e.result, e.reason) switch
        {
            ("win", "forfeit") => $"{_opponentName} forfeited — you win.",
            ("loss", "forfeit") => $"You forfeited — {_opponentName} wins.",
            ("win", _)  => "You hold the line. Victory.",
            ("loss", _) => $"{_opponentName} holds the line.",
            ("draw", _) => "Stalemate. The galaxy holds its breath.",
            _ => "Match ended."
        };
        _netResultClass = e.result switch
        {
            "win" => _yourFaction == Player.Ascendant ? "ascendant" : "vanguard",
            "loss" => _yourFaction == Player.Ascendant ? "vanguard" : "ascendant",
            _ => "none"
        };
        _netWinningCells = e.winningCells?.Select(c => (c.row, c.col)).ToArray();
        InvokeAsync(StateHasChanged);
    }

    // Helpers
    private static Board DeserializeBoard(int[][] cells)
    {
        var b = new Board();
        for (int r = 0; r < 3; r++)
            for (int c = 0; c < 3; c++)
                if (cells[r][c] != 0)
                    b.TryPlace(r, c, (Player)cells[r][c]);
        return b;
    }

    private static Player ParsePlayer(string s) => s switch
    {
        "Ascendant" => Player.Ascendant,
        "Vanguard"  => Player.Vanguard,
        _           => Player.None
    };

    private static string FactionClass(Player p) => p switch
    {
        Player.Ascendant => "ascendant",
        Player.Vanguard  => "vanguard",
        _                => "none"
    };
}
